rules_version = '2';
// Private beta: each user can read and write only their own workspace, and only
// allow-listed accounts can sign in. Edit the list to match VITE_ALLOWED_EMAILS.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['you@example.com'];
    }
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
      match /{collection}/{docId} {
        allow read, write: if allowed() && request.auth.uid == uid
          && collection in ['deals', 'tasks', 'professionals', 'quotes', 'letters', 'searches', 'discoveries'];
      }
      // Raw listing records written only by Cloud Functions (licensed feeds); the app ingests
      // them into discoveries and deletes them.
      match /incoming/{docId} {
        allow read, delete: if allowed() && request.auth.uid == uid;
      }
    }
  }
}
