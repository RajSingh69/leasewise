# Leasewise configuration. Copy to .env.local and fill in. Never commit real values.
# Leave the Firebase values empty to run in local mode (data stays in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated emails allowed to sign in (must match firestore.rules allowlist)
VITE_ALLOWED_EMAILS=

# EPC register token (free): sign in at https://get-energy-performance-data.communities.gov.uk
# with GOV.UK One Login and copy the bearer token from "My account". Server-side only —
# do NOT prefix with VITE_. Used by the dev-server proxy; in production store it with
#   firebase functions:secrets:set EPC_API_TOKEN
EPC_API_TOKEN=
